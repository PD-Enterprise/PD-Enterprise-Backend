{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": ".",
    "paths": {
      "@/src/*": ["src/*"],
      "@/drizzle/*": ["drizzle/*"],
      "@/utils/*": ["src/utils/*"],
      "@/db/*": ["src/db/*"],
      "@/convex/*": ["convex/*"],
    },
  }
}
